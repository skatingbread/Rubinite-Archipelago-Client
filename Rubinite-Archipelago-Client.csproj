<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<AssemblyName>Rubinite_Archipelago_Client</AssemblyName>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Product>Rubinite Archipelago</Product>
		<Version>0.0.0</Version>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
		<RestoreAdditionalProjectSources>
			https://api.nuget.org/v3/index.json;
			https://nuget.bepinex.dev/v3/index.json;
			https://nuget.samboy.dev/v3/index.json
		</RestoreAdditionalProjectSources>
		<RootNamespace>Rubinite_Archipelago_Client</RootNamespace>
	</PropertyGroup>

	<Target Name="WhitelistCopyLocalPaths" AfterTargets="ResolveLockFileCopyLocalProjectDeps">
		<ItemGroup>
			<!-- IMPORTANT: This whitelists is hard-coded... probably fine -->
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' != 'Rubinite_Archipelago_Client.dll' &#xD;&#xA;                                     And '%(Filename)' != 'Archipelago.MultiClient.Net.dll'" />
		</ItemGroup>
	</Target>

	<Target Name="CopyOutputToAnotherFolder" AfterTargets="AfterBuild">
		<ItemGroup>
			<OutputFiles Include="$(TargetDir)**\*Rubinite*.dll" />
			<OutputFiles Include="$(TargetDir)**\*Archipelago*.dll" />
		</ItemGroup>
		<!-- IMPORTANT: hard-codes Steam Folder :( whatever... -->
		<Copy SourceFiles="@(OutputFiles)" DestinationFolder="C:\Program Files (x86)\Steam\steamapps\common\Rubinite\BepInEx\plugins\Rubinite_Archipelago_Client\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>

	<ItemGroup>
		<PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
		<PackageReference Include="Archipelago.MultiClient.Net.Analyzers" Version="2.0.3">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
		<PackageReference Include="BepInEx.Core" Version="5.*" />
		<PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
		<PackageReference Include="UnityEngine.Modules" Version="6000.3.12" IncludeAssets="compile" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="Assembly-CSharp">
	    <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Rubinite\Rubinite_Data\Managed\Assembly-CSharp.dll</HintPath>
	  </Reference>
	  <Reference Include="Coffee.UIParticle">
	    <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Rubinite\Rubinite_Data\Managed\Coffee.UIParticle.dll</HintPath>
	  </Reference>
	  <Reference Include="com.rlabrecque.steamworks.net">
	    <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Rubinite\Rubinite_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath>
	  </Reference>
	  <Reference Include="DiscordWebhook">
	    <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Rubinite\Rubinite_Data\Managed\DiscordWebhook.dll</HintPath>
	  </Reference>
	  <Reference Include="FMODUnity">
	    <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Rubinite\Rubinite_Data\Managed\FMODUnity.dll</HintPath>
	  </Reference>
	  <Reference Include="PugTool">
	    <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Rubinite\Rubinite_Data\Managed\PugTool.dll</HintPath>
	  </Reference>
	  <Reference Include="RubyTextMeshPro">
